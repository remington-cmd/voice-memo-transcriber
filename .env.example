# Get your key at: platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=sk-...your-key-here

# Password the API routes require (type it into the page's password field).
# Required in production: without it the API answers 503, because otherwise
# anyone with the URL could spend your OpenAI credit. `next dev` runs without it.
# Use at least 20 random characters, e.g. the output of: openssl rand -base64 24
# On Vercel, set it for both Production and Preview.
ACCESS_PASSWORD=

# Set to 1 only to deliberately run a production deploy with no password.
# ALLOW_PUBLIC=1

# Optional model overrides. Both defaults are on OpenAI's deprecation schedule
# (https://developers.openai.com/api/docs/deprecations, checked 2026-10-14):
#   whisper-1 shuts down 2027-02-26; OpenAI's replacement is gpt-transcribe (or gpt-live-transcribe).
#   gpt-4o-mini (snapshot gpt-4o-mini-2024-07-18) shuts down 2027-01-14; the replacement is gpt-6-luna.
# Test a replacement on a real recording before switching (see README, "Models").
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
