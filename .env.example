# Get your key at: platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=sk-...your-key-here

# Password the API routes require (type it into the page's password field).
# Strongly recommended: without it, anyone with the URL spends your OpenAI credit.
# Use at least 20 random characters, e.g. the output of: openssl rand -base64 24
# On Vercel, set it for both Production and Preview.
ACCESS_PASSWORD=
